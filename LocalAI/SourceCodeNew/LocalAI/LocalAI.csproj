<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>warnings</Nullable>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<Platforms>x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
		<AssemblyName>LocalAI</AssemblyName>
		<RootNamespace>LocalAI</RootNamespace>
		<!-- ParamLayout patches a few fields inside llama.cpp's opaque by-value
		     parameter blobs. Pointer arithmetic on a fixed-size struct is what
		     unsafe is for; nothing else in the extension uses it. -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Peakboard.ExtensionKit" Version="4.0.1">
			<Private>false</Private>
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- llama.cpp, CPU only. MIT, as is ggml.

	     2.0 replaced ONNX Runtime GenAI with this. The case is in
	     LocalAI/MIGRATION-llamacpp.md; briefly, it is 2-3x faster generating on a
	     Peakboard Box, needs a ninth of the memory, and reads GGUF - the format
	     the model ecosystem actually publishes, which ORT GenAI's does not.

	     These are the binaries from release b11070, committed rather than
	     restored so the build is reproducible and the P/Invoke offsets in
	     LlamaNative.cs keep matching the header they were written against.

	     Fourteen ggml-cpu-*.dll are shipped, not one. llama.cpp dispatches on
	     instruction set at load: a Box picks ggml-cpu-sse42.dll (its Celeron has
	     no AVX), a modern PC picks alderlake or zen4. Ship only one and either the
	     Box or every BYOD device loses. libomp.dll is needed by all of them.

	     They must end up flat beside LocalAI.dll, because LlmEngine loads them by
	     absolute path from the assembly's own folder and then points
	     ggml_backend_load_all_from_path at it. -->
	<ItemGroup>
		<None Include="llamacpp\*.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>%(Filename)%(Extension)</Link>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Update="Extension.xml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="NOTICE.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Qwen3-0.6B-LICENSE.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Remove="LocalAI.png" />
		<EmbeddedResource Include="LocalAI.png" />
	</ItemGroup>

	<!-- The Visual C++ runtime, shipped inside the package.

	     llama.dll, ggml.dll and every ggml-cpu-*.dll import MSVCP140/VCRUNTIME140
	     dynamically - the same dependency ONNX Runtime had - so they need whatever
	     copy the host process resolves. That
	     host is Peakboard.ExtensionKit.Process64.exe, which bundles none of its
	     own and therefore takes System32's. A developer PC has a current one; a
	     Peakboard Box ships 14.24 and never updates, and a stock Box has none at
	     all: 1.2 failed on a reviewer's untouched Box with 0x8007007E, "the
	     specified module could not be found" - naming neither this DLL nor the
	     cause.

	     A copy beside the native DLLs wins over System32, so shipping a current
	     one fixes it with nothing asked of the customer. Verified both ways on
	     PB10424: bundling a 14.25 copy reproduces the customer failure on a Box
	     that has a good system runtime, and bundling 14.51 answers normally at
	     unchanged speed. See _platform/ERRATA.md entry 87.

	     Keep these current. They are backward compatible, so a newer copy serves
	     anything else in the host process too, but an older one would not. -->
	<ItemGroup>
		<None Include="vcruntime\*.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>%(Filename)%(Extension)</Link>
		</None>
	</ItemGroup>

</Project>
